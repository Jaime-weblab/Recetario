# Copia este archivo como .env.local y rellena los valores (nunca subas .env.local a git).

# --- Supabase (Project Settings → API) ---
# URL del proyecto y clave pública "anon". Son públicas: viajan al navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio: salta la seguridad RLS. SOLO servidor. Aún no se usa (fases posteriores).
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Fase 4) --- SOLO servidor.
ANTHROPIC_API_KEY=
